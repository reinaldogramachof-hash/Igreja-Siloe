# OPS-01 - homologacao HostGator Plano M (frontend estatico, sem Node).
# Gerado a partir do export estatico (next.config.ts: output "export",
# trailingSlash true) - cada rota ja tem seu proprio index.html, entao nao
# precisa de rewrite de SPA para recarga de rota profunda.

# Forca HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Pagina de erro 404 (gerada pelo Next.js)
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Cabecalhos de seguranca em toda resposta
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

  # HTML e o service worker nunca ficam em cache do navegador/CDN - precisam
  # ser revalidados a cada visita para o PWA atualizar sem servir dado velho
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-store, must-revalidate"
  </FilesMatch>
  <Files "sw.js">
    Header always set Cache-Control "no-store, must-revalidate"
  </Files>
  <Files "manifest.json">
    Header always set Cache-Control "no-store, must-revalidate"
  </Files>
</IfModule>

# Assets com hash no nome (_next/static) sao imutaveis - cache longo
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "^_next/static/">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <LocationMatch "^/_next/static/">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </LocationMatch>
</IfModule>
